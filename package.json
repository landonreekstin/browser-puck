{
  "name": "browser-puck",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p shared && tsc -p server && tsc -p client && tsc -p scripts",
    "verify:ping": "tsx scripts/verify-ping.ts",
    "verify:sandbox": "tsx scripts/verify-sandbox.ts",
    "bot": "npm run bot -w @puck/server --",
    "verify:room": "tsx scripts/verify-room.ts",
    "verify:netcode": "tsx scripts/verify-netcode.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "playwright-core": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
